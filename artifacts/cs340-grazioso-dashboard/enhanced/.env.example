# CS 499 Database Enhancement - Safe configuration example
# Copy this file to .env or export these values before running.
# Do not commit real usernames, passwords, or production secrets.

MONGO_USER=your_username_here
MONGO_PASS=your_password_here
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=aac
MONGO_COLLECTION=animals
MONGO_AUTH_SOURCE=admin
MONGO_APP_ROLE=read
